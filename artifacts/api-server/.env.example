# DeepSeek (Autopublicador Social — generación de copy)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Cloudflare Turnstile (verificación humana en el login del portal, P-81)
# Sin configurar, el login funciona sin verificación (no bloquea local dev).
TURNSTILE_SECRET_KEY=

# Jotform webhook (asistente de WhatsApp/Facebook → prospectos, P-81)
# Sin configurar, el endpoint rechaza todo con 503 (fail-closed a propósito
# — a diferencia de Turnstile, este endpoint escribe en la CRM).
JOTFORM_WEBHOOK_SECRET=

# PayPal (P-payments: anticipo/hitos de propuestas + mensualidad recurrente)
# PAYPAL_ENV: "sandbox" | "live" — default sandbox si no se define, nunca
# apunta a producción por accidente.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook: sin configurar, el endpoint rechaza todo con 503 (fail-closed,
# igual que Jotform).
PAYPAL_WEBHOOK_ID=
# Plan de facturación reutilizable para la mensualidad recurrente — creado
# una sola vez de forma manual (no por código), el precio se sobreescribe
# por cliente al crear cada suscripción.
PAYPAL_PLAN_ID=

# DocuSeal (Digital Contract Engine — firma electrónica real de contratos,
# self-hosted fuera de este repo). Sin configurar, el endpoint rechaza todo
# con 503 (fail-closed, igual que Jotform/PayPal) — un firmante forjado aquí
# sería exactamente el hueco legal que esta integración existe para cerrar.
DOCUSEAL_WEBHOOK_SECRET=
# API token (Settings -> API in the DocuSeal admin panel) for creating
# submissions server-side — distinct from DOCUSEAL_WEBHOOK_SECRET above,
# which only verifies inbound webhooks.
DOCUSEAL_API_TOKEN=
DOCUSEAL_BASE_URL=

# Becky Beck's original P-77 catalog (Netlify Functions + Blobs, separate
# becky-beck-site repo/site) — read-only proxy for the Client Room catalog
# page. No token needed: this hits that site's own public Functions.
# Optional, defaults to the real deployed site.
BECKY_BECK_LEGACY_SITE_URL=

# Product catalog images (pendiente #5) — used to build absolute image URLs
# on the public/unauthenticated storefront endpoints (a different origin,
# e.g. Becky Beck's own site, needs a full URL, unlike the authenticated
# admin/client-room routes which stay relative to /api). Same Netlify Blobs
# site/token as NETLIFY_API_TOKEN/BECKY_BECK_SITE_ID above (product-images
# store, shared with becky-beck/fiscal-documents).
API_PUBLIC_BASE_URL=
