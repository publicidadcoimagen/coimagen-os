# DeepSeek (Autopublicador Social — generación de copy)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Cloudflare Turnstile (verificación humana en el login del portal, P-81)
# Sin configurar, el login funciona sin verificación (no bloquea local dev).
TURNSTILE_SECRET_KEY=

# Jotform webhook (asistente de WhatsApp/Facebook → prospectos, P-81)
# Sin configurar, el endpoint rechaza todo con 503 (fail-closed a propósito
# — a diferencia de Turnstile, este endpoint escribe en la CRM).
JOTFORM_WEBHOOK_SECRET=

# PayPal (P-payments: anticipo/hitos de propuestas + mensualidad recurrente)
# PAYPAL_ENV: "sandbox" | "live" — default sandbox si no se define, nunca
# apunta a producción por accidente.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook: sin configurar, el endpoint rechaza todo con 503 (fail-closed,
# igual que Jotform).
PAYPAL_WEBHOOK_ID=
# Plan de facturación reutilizable para la mensualidad recurrente — creado
# una sola vez de forma manual (no por código), el precio se sobreescribe
# por cliente al crear cada suscripción.
PAYPAL_PLAN_ID=
